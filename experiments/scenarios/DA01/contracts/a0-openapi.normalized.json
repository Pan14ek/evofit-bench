{
  "components": {
    "schemas": {
      "FaultUpdate": {
        "description": "Validated fault configuration update.",
        "properties": {
          "fail_next_n_notifications": {
            "default": 0,
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Fail Next N Notifications",
            "type": "integer"
          },
          "notification_delay_ms": {
            "default": 0,
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Notification Delay Ms",
            "type": "integer"
          },
          "task_delay_ms": {
            "default": 0,
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Task Delay Ms",
            "type": "integer"
          }
        },
        "title": "FaultUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NotificationRead": {
        "description": "Public notification representation.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "type",
          "message",
          "created_at"
        ],
        "title": "NotificationRead",
        "type": "object"
      },
      "TaskAssign": {
        "description": "Assignment command.",
        "properties": {
          "actor_user_id": {
            "format": "uuid",
            "title": "Actor User Id",
            "type": "string"
          },
          "assignee_user_id": {
            "format": "uuid",
            "title": "Assignee User Id",
            "type": "string"
          }
        },
        "required": [
          "assignee_user_id",
          "actor_user_id"
        ],
        "title": "TaskAssign",
        "type": "object"
      },
      "TaskCreate": {
        "description": "Fields required to create a task.",
        "properties": {
          "creator_user_id": {
            "format": "uuid",
            "title": "Creator User Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "creator_user_id"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskRead": {
        "description": "Public task representation.",
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
