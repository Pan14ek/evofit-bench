          "id",
          "title",
          "description",
          "status",
          "created_by",
          "assignee_id",
          "created_at",
          "updated_at"
        ],
        "title": "TaskRead",
        "type": "object"
      },
      "TaskStatus": {
        "description": "Supported task lifecycle states.",
        "enum": [
          "TODO",
          "IN_PROGRESS",
          "DONE",
          "CANCELLED"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskStatusChange": {
        "description": "Task status transition command.",
        "properties": {
          "actor_user_id": {
            "format": "uuid",
            "title": "Actor User Id",
            "type": "string"
          },
