          }
        },
        "required": [
          "status",
          "actor_user_id"
        ],
        "title": "TaskStatusChange",
        "type": "object"
      },
      "TaskSummary": {
        "description": "Counts used in the basic task summary.",
        "properties": {
          "assigned_task_count": {
            "title": "Assigned Task Count",
            "type": "integer"
          },
          "count_by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Count By Status",
            "type": "object"
          },
          "total_task_count": {
            "title": "Total Task Count",
            "type": "integer"
          },
          "unassigned_task_count": {
            "title": "Unassigned Task Count",
            "type": "integer"
          }
        },
        "required": [
          "total_task_count",
          "count_by_status",
          "assigned_task_count",
          "unassigned_task_count"
        ],
        "title": "TaskSummary",
        "type": "object"
      },
      "UserCreate": {
        "description": "Fields required to create a user.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
