{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.local/schemas/ground_truth.schema.json",
  "title": "EvoFitBench frozen ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_id", "frozen_before_implementation", "source_architecture_tag",
    "source_architecture_revision", "criteria_assessment", "classification_universe",
    "affected_targets", "expected_operations", "required_obligations_after",
    "retained_representations", "seeded_faults", "prohibited_unplanned_changes"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "scenario_id": {"type": "string", "pattern": "^DA[0-9]{2}$"},
    "frozen_before_implementation": {
      "const": true,
      "description": "Registered ground truth must be frozen before implementation."
    },
    "source_architecture_tag": {"type": "string", "minLength": 1},
    "source_architecture_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "criteria_assessment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["affected"], "additionalProperties": false,
        "properties": {"affected": {"type": "boolean"}, "rationale": {"type": "string"}}
      }
    },
    "classification_universe": {
      "type": "object", "additionalProperties": false,
      "required": ["existing_representations", "new_obligations"],
      "properties": {
        "existing_representations": {"$ref": "#/$defs/stableIds"},
        "new_obligations": {"$ref": "#/$defs/stableIds"}
      }
    },
    "affected_targets": {
      "description": "Targets with expected operations other than retain; cross-artifact consistency is validated in tests.",
      "type": "array", "items": {"$ref": "#/$defs/affectedTarget"}, "uniqueItems": true
    },
    "expected_operations": {
      "description": "Total ground-truth operation mapping over every target in classification_universe.",
      "type": "object", "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"enum": ["retain", "replace", "add", "deactivate", "adjust"]}
    },
    "required_obligations_after": {
      "description": "Complete active obligation set Q(A_after), including obligations unaffected by the current delta.",
      "$ref": "#/$defs/stableIds"
    },
    "retained_representations": {
      "description": "Representation targets whose expected operation is retain.",
      "$ref": "#/$defs/stableIds"
    },
    "seeded_faults": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "prohibited_unplanned_changes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "stableIds": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "uniqueItems": true},
    "affectedTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target_type", "target_id", "expected_operation", "rationale"],
      "properties": {
        "target_type": {"enum": ["representation", "obligation"]},
        "target_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "expected_operation": {"enum": ["retain", "replace", "add", "deactivate", "adjust"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"target_type": {"const": "obligation"}}, "required": ["target_type"]},
         "then": {"properties": {"expected_operation": {"const": "add"}}}},
        {"if": {"properties": {"target_type": {"const": "representation"}}, "required": ["target_type"]},
         "then": {"properties": {"expected_operation": {"enum": ["retain", "replace", "deactivate", "adjust"]}}}}
      ]
    }
  }
}
