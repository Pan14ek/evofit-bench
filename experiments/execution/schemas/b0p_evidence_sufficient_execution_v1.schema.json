{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evofitbench:b0p-evidence-sufficient-execution:v1",
  "title": "B0/P E1 evidence-sufficient DEVELOPMENT execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "run_id", "execution_status", "exposure_class", "e0",
    "preparation", "source_revisions", "evaluator_source_revision", "evaluator_source_scope", "runtime_contexts", "runtime_images",
    "e1_evidence", "arms", "P_outcomes", "governance_decision", "evaluator_execution",
    "semantic_pair_verification", "rq1_scoring", "rq2_scoring", "resource_metrics",
    "research_gates", "limitations", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "DEV-B0P-V1-E1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "execution_status": {"enum": ["EXECUTED_COMPLETE", "EXECUTED_PARTIAL"]},
    "exposure_class": {"const": "CALIBRATION_EXPOSED"},
    "e0": {"type": "object", "additionalProperties": false, "required": ["run_id", "status", "reused_or_modified", "known_outcome_summary"], "properties": {"run_id": {"const": "dev-b0p-20261020-execution-a04"}, "status": {"const": "PRESERVED_IMMUTABLE_HISTORICAL_OBSERVATION"}, "reused_or_modified": {"const": false}, "known_outcome_summary": {"type": "string", "minLength": 1}}},
    "preparation": {"type": "object", "additionalProperties": false, "required": ["run_id", "manifest_sha256", "verified"], "properties": {"run_id": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "verified": {"const": true}}},
    "source_revisions": {"type": "object", "additionalProperties": false, "required": ["architecture_before_sha", "architecture_after_sha", "b0_source_sha", "p_source_sha", "policy_source_sha"], "properties": {"architecture_before_sha": {"$ref": "#/$defs/sha1"}, "architecture_after_sha": {"$ref": "#/$defs/sha1"}, "b0_source_sha": {"$ref": "#/$defs/sha1"}, "p_source_sha": {"$ref": "#/$defs/sha1"}, "policy_source_sha": {"$ref": "#/$defs/sha1"}}},
    "evaluator_source_revision": {"$ref": "#/$defs/sha1"},
    "evaluator_source_scope": {"type": "string", "minLength": 1},
    "runtime_contexts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}, "required": ["B0", "P"]},
    "runtime_images": {"type": "object", "additionalProperties": {"type": "object"}, "required": ["B0", "P"]},
    "e1_evidence": {"type": "object", "additionalProperties": false, "required": ["reference_path", "reference_sha256", "reference_status", "p_input_path", "p_input_bundle_sha256", "p_policy_source_revision", "adaptation_evidence_sidecar_path", "adaptation_evidence_sidecar_sha256", "adaptation_evidence_trust_scope", "semantic_verification_path", "semantic_pair_count", "reference_mounted_in_method_environment", "e0_run_id", "e0_reused_or_modified"], "properties": {"reference_path": {"type": "string"}, "reference_sha256": {"$ref": "#/$defs/sha256"}, "reference_status": {"const": "AUTHOR_DECLARED_CALIBRATION_EXPOSED"}, "p_input_path": {"type": "string"}, "p_input_bundle_sha256": {"$ref": "#/$defs/sha256"}, "p_policy_source_revision": {"type": "string", "pattern": "^PILOT02_TEST_ONLY_[a-z0-9][a-z0-9._-]{2,95}$"}, "adaptation_evidence_sidecar_path": {"type": "string"}, "adaptation_evidence_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "adaptation_evidence_trust_scope": {"const": "TEST_ONLY"}, "semantic_verification_path": {"type": "string"}, "semantic_pair_count": {"const": 2}, "reference_mounted_in_method_environment": {"const": false}, "e0_run_id": {"const": "dev-b0p-20261020-execution-a04"}, "e0_reused_or_modified": {"const": false}}},
    "arms": {"type": "object", "additionalProperties": false, "required": ["B0", "P"], "properties": {"B0": {"$ref": "#/$defs/arm"}, "P": {"$ref": "#/$defs/arm"}}},
    "P_outcomes": {"type": "object"},
    "governance_decision": {"type": "object", "additionalProperties": false, "required": ["B0", "P", "P_reason_codes"], "properties": {"B0": {"const": "NOT_APPLICABLE"}, "P": {"enum": ["ACCEPT", "REJECT", "HOLD", "INPUT_REJECTED", "UNKNOWN"]}, "P_reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "evaluator_execution": {"type": "object", "additionalProperties": false, "required": ["status", "observations", "evaluator_time_ns", "verification_time_ns"], "properties": {"status": {"enum": ["COMPLETED", "PARTIAL"]}, "observations": {"type": "array", "items": {"type": "object"}}, "evaluator_time_ns": {"type": "integer", "minimum": 0}, "verification_time_ns": {"type": "integer", "minimum": 0}}},
    "semantic_pair_verification": {"type": "object", "additionalProperties": true, "required": ["status", "independently_verified_pair_count", "unknown_pair_count", "required_obligations", "pairs", "reason_codes"], "properties": {"status": {"enum": ["VERIFIED", "PARTIAL", "UNKNOWN"]}, "independently_verified_pair_count": {"type": "integer", "minimum": 0}, "unknown_pair_count": {"type": "integer", "minimum": 0}, "required_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "pairs": {"type": "array", "items": {"type": "object"}}, "reason_codes": {"type": "array", "items": {"type": "string"}}}},
    "rq1_scoring": {"type": "object", "additionalProperties": false, "required": ["schema_version", "status", "reason", "reference_path", "reference_sha256", "scorer_invoked", "results"], "properties": {"schema_version": {"const": 1}, "status": {"enum": ["SCORED", "NOT_EVALUABLE"]}, "reason": {"type": "string", "minLength": 1}, "reference_path": {"type": "string"}, "reference_sha256": {"$ref": "#/$defs/sha256"}, "scorer_invoked": {"type": "boolean"}, "results": {"type": "object", "additionalProperties": true}}},
    "rq2_scoring": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "required_obligation_set_bound", "same_denominator_for_arms", "result_path", "diagnostic_pairs_path"], "properties": {"status": {"enum": ["UNKNOWN", "SCORED", "PARTIAL"]}, "reason": {"type": "string", "minLength": 1}, "required_obligation_set_bound": {"const": true}, "same_denominator_for_arms": {"const": true}, "result_path": {"type": "string"}, "diagnostic_pairs_path": {"type": "string"}}},
    "resource_metrics": {"type": "object", "additionalProperties": true, "required": ["status", "host_cpu_time_ns", "container_cpu_time_ns", "peak_rss_bytes"], "properties": {"status": {"enum": ["UNKNOWN", "MEASURED"]}, "host_cpu_time_ns": {"type": ["integer", "null"]}, "container_cpu_time_ns": {"type": ["integer", "null"]}, "peak_rss_bytes": {"type": ["integer", "null"]}}},
    "research_gates": {"type": "object", "additionalProperties": false, "required": ["G1", "G4", "P_ALGORITHM_STATUS"], "properties": {"G1": {"const": "INCOMPLETE"}, "G4": {"const": "NOT AUTHORIZED"}, "P_ALGORITHM_STATUS": {"const": "NOT_READY"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "arm": {"type": "object", "additionalProperties": true, "required": ["method_id", "status", "method_version", "source_sha", "input_bundle_sha256", "method_execution_time_ns", "adaptation_time_ns", "prediction_status", "prediction_sha256", "prediction_path", "trace_path", "trace_sha256", "runtime_image_id", "stdout_path", "stdout_sha256", "stderr_path", "stderr_sha256"], "properties": {"method_id": {"enum": ["B0", "P"]}, "status": {"const": "COMPLETED"}, "source_sha": {"$ref": "#/$defs/sha1"}, "input_bundle_sha256": {"$ref": "#/$defs/sha256"}, "method_execution_time_ns": {"type": "integer", "minimum": 0}, "adaptation_time_ns": {"type": "integer", "minimum": 0}, "prediction_status": {"enum": ["SEALED", "NOT_EMITTED_GOVERNANCE_HOLD", "NOT_EMITTED_REJECT", "NOT_EMITTED_INPUT_REJECTED"]}, "prediction_sha256": {"$ref": "#/$defs/sha256"}, "prediction_path": {"type": "string"}, "trace_path": {"type": "string"}, "trace_sha256": {"$ref": "#/$defs/sha256"}, "runtime_image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "stdout_path": {"type": "string"}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_path": {"type": "string"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
