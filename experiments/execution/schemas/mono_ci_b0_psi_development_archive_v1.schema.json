{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_b0_psi_development_archive_v1.schema.json",
  "title": "MONO CI B0/Ψ DEVELOPMENT raw evidence archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_purpose", "execution_id", "workflow", "source_revision_sha", "execution_record_sha256", "run_inventory_sha256", "baseline", "authorization_boundary", "cases", "environment", "reproduction_commands", "members"],
  "properties": {
    "schema_version": {"const": "MONO_CI_B0_PSI_DEVELOPMENT_ARCHIVE_V1"},
    "archive_purpose": {"const": "DEVELOPMENT_RAW_EVALUATOR_EVIDENCE_ONLY"},
    "execution_id": {"type": "string", "pattern": "^DEV_MONO_CI_[A-Za-z0-9_-]{1,48}$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_url", "artifact_name", "retention_days"],
      "properties": {
        "run_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/.+/actions/runs/[0-9]+$"},
        "artifact_name": {"type": "string", "pattern": "^mono-ci-b0-psi-development-[A-Za-z0-9_-]+$"},
        "retention_days": {"const": 90}
      }
    },
    "source_revision_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "execution_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "configuration_sha256", "identity_status", "approval_status"],
      "properties": {
        "configuration_id": {"const": "MONO_CI_RECONSTRUCTED_B0_A03_V1"},
        "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "identity_status": {"const": "PROSPECTIVE_RECONSTRUCTION_NOT_HISTORICAL"},
        "approval_status": {"const": "NOT_APPROVED"}
      }
    },
    "authorization_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_readiness", "measurement_status", "p_algorithm_status", "g1", "g4", "reference_gate", "psi_status", "scoring"],
      "properties": {
        "study_readiness": {"const": "NO_GO"},
        "measurement_status": {"const": "NOT_EXECUTED"},
        "p_algorithm_status": {"const": "NOT_READY"},
        "g1": {"const": "INCOMPLETE"},
        "g4": {"const": "NOT_AUTHORIZED"},
        "reference_gate": {"const": "NOT_READY"},
        "psi_status": {"const": "BLOCKED_NOT_EXECUTED"},
        "scoring": {"const": "NOT_EXECUTED_NO_SCORER_REFERENCE"}
      }
    },
    "cases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/caseProvenance"}},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "operating_system", "architecture", "uv_version", "pyproject_sha256", "uv_lock_sha256"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "uv_version": {"type": "string", "minLength": 1},
        "pyproject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "uv_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reproduction_commands": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "members": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/member"}}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.git(?:/|$))(?!.*(?:scorer|scoring|oracle|reference|expected_outputs|ground_truth|groundtruth|eval01|eval02|evaluator_control_expectations)(?:/|$)).+$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "caseProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_commit_sha", "repository_tree_sha", "application_tree_sha", "input_bundle_sha256", "common_input_sha256", "execution_binding", "evaluators"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^CASE_0[1-4]$"},
        "source_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "repository_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "application_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "common_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "execution_binding": {"$ref": "#/$defs/executionBinding"},
        "evaluators": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/evaluator"}}
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_kind", "checkout_commit_sha", "repository_tree_sha", "application_tree_sha", "source_file_count", "source_file_map_sha256", "input_bundle_sha256", "target_state_manifest_path", "target_state_manifest_sha256", "evaluator_configurations"],
      "properties": {
        "workspace_kind": {"const": "GIT_CHECKOUT_BYTE_EQUIVALENT_TO_VERIFIED_BUNDLE"},
        "checkout_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "repository_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "application_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_file_count": {"type": "integer", "minimum": 1},
        "source_file_map_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "target_state_manifest_path": {"const": "architecture/state-target.yaml"},
        "target_state_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_configurations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["evaluator_id", "bundle_path", "configuration_sha256"], "properties": {"evaluator_id": {"enum": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"]}, "bundle_path": {"type": "string", "pattern": "^evaluators/AC_(PUBLIC_API|MODULE_GRAPH)\\.yaml$"}, "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "version", "source_sha256", "configuration_sha256", "exit_code", "compliance", "raw_output_path", "raw_output_sha256"],
      "properties": {
        "evaluator_id": {"enum": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"]},
        "version": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exit_code": {"type": "integer"},
        "compliance": {"enum": ["COMPLIANT", "NON_COMPLIANT", "NOT_EVALUABLE", "UNKNOWN", "NOT_APPLICABLE"]},
        "raw_output_path": {"type": "string", "pattern": "^B0/raw/CASE_0[1-4]/AC_(PUBLIC_API|MODULE_GRAPH)\\.json$"},
        "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
