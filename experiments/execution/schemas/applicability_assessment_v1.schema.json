{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evofitbench:applicability-assessment:v1",
  "title": "Development-only applicability assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "ruleset_version",
    "fact_vocabulary_version",
    "policy_registry_version",
    "policy_source_revision",
    "policy_as_of",
    "architecture_source_sha",
    "architecture_state",
    "common_input_sha256",
    "ruleset_sha256",
    "policy_bundle_sha256",
    "input_validation",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "engine_version": {"const": "P_APPLICABILITY_ENGINE_V1"},
    "ruleset_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "fact_vocabulary_version": {"const": "FV_CORE_V1"},
    "policy_registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_as_of": {"type": "string", "format": "date-time"},
    "architecture_source_sha": {"$ref": "#/$defs/sha1"},
    "architecture_state": {"enum": ["before", "after"]},
    "common_input_sha256": {"$ref": "#/$defs/sha256"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "policy_bundle_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "input_validation": {"$ref": "#/$defs/validationSummary"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_status",
        "integrity_status",
        "authority_status",
        "fact_status",
        "completeness_status",
        "reason_codes"
      ],
      "properties": {
        "schema_status": {"enum": ["VALID", "INVALID", "UNDETERMINED"]},
        "integrity_status": {"enum": ["VALID", "INVALID", "UNDETERMINED"]},
        "authority_status": {"enum": ["VALID", "INVALID", "UNDETERMINED"]},
        "fact_status": {"enum": ["VALID", "INVALID", "UNDETERMINED"]},
        "completeness_status": {"enum": ["VALID", "INVALID", "UNDETERMINED"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reasonCode"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "status",
        "reason_codes",
        "contributing_policy_ids",
        "condition_ids",
        "evidence_refs",
        "unresolved_refs"
      ],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/reference"},
        "status": {"enum": ["ACTIVE", "INACTIVE", "UNKNOWN"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reasonCode"}
        },
        "contributing_policy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "unresolved_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  }
}
