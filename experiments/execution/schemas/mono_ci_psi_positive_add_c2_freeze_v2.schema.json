{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_positive_add_c2_freeze_v2.schema.json",
  "title": "C2 V2 frozen exact-set TEST_ONLY experiment inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "classification",
    "implementation_commit",
    "protocol_sha256",
    "profile_sha256",
    "source_identities",
    "method",
    "schema_sha256",
    "evaluators",
    "docker",
    "preflight_sha256",
    "host_identity",
    "uv_version",
    "repetitions",
    "cost_rule",
    "official_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "MONO_CI_A05_POSITIVE_ADD_C2_FREEZE_V2"
    },
    "study_id": {
      "const": "MONO_CI_A05_POSITIVE_ADD_C2_TEST_ONLY_V2"
    },
    "classification": {
      "const": "PRE_RUN_FREEZE_TEST_ONLY_AUTHOR_DECLARED_DEVELOPMENT"
    },
    "implementation_commit": {
      "$ref": "#/$defs/sha1"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_commit_sha",
        "after_commit_sha",
        "before_application_tree_sha",
        "after_application_tree_sha",
        "before_state_manifest_sha256",
        "after_state_manifest_sha256"
      ],
      "properties": {
        "before_commit_sha": {
          "const": "d3101c0d3aa9b7b709253b6ec7518416f05f65b9"
        },
        "after_commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "before_application_tree_sha": {
          "const": "007196f68652bc13f6798805793ffdfae96f95f7"
        },
        "after_application_tree_sha": {
          "const": "007196f68652bc13f6798805793ffdfae96f95f7"
        },
        "before_state_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_state_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 9
    },
    "schema_sha256": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "minProperties": 5
    },
    "evaluators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_sha256",
        "public_api_configuration_sha256",
        "module_graph_configuration_sha256",
        "ownership_configuration_sha256",
        "source_files"
      ],
      "properties": {
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_api_configuration_sha256": {
          "const": "8853c3a933b23f698c7ba7c5b6e511f292e8d9285dc0de4378741c53e466f7bb"
        },
        "module_graph_configuration_sha256": {
          "const": "1abae6871a477ff2a07685ad645a70defa2f1ac6745598ae4cdc35aab4e95bf6"
        },
        "ownership_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "platform",
        "network",
        "method_input_mount",
        "writable_output_mounts"
      ],
      "properties": {
        "image": {
          "const": "python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70"
        },
        "platform": {
          "const": "linux/amd64"
        },
        "network": {
          "const": "none"
        },
        "method_input_mount": {
          "const": "read-only"
        },
        "writable_output_mounts": {
          "const": 1
        }
      }
    },
    "preflight_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "host_identity": {
      "type": "object",
      "minProperties": 1
    },
    "uv_version": {
      "type": "string",
      "minLength": 1
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup",
        "measured"
      ],
      "properties": {
        "warmup": {
          "const": 1
        },
        "measured": {
          "const": 3
        }
      }
    },
    "cost_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incremental_evaluator_id",
        "max_incremental_cost_ms",
        "max_search_nodes",
        "unavailable_or_exceeded_behavior"
      ],
      "properties": {
        "incremental_evaluator_id": {
          "const": "AC_DATA_OWNERSHIP"
        },
        "max_incremental_cost_ms": {
          "const": 225
        },
        "max_search_nodes": {
          "const": 2
        },
        "unavailable_or_exceeded_behavior": {
          "const": "HOLD_AND_DO_NOT_SELECT_TEMPLATE"
        }
      }
    },
    "official_boundary": {
      "$ref": "#/$defs/gates"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_readiness",
        "measurement_status",
        "P_ALGORITHM_STATUS",
        "G1",
        "G4",
        "reference",
        "scoring"
      ],
      "properties": {
        "study_readiness": {
          "const": "NO_GO"
        },
        "measurement_status": {
          "const": "NOT_EXECUTED"
        },
        "P_ALGORITHM_STATUS": {
          "const": "NOT_READY"
        },
        "G1": {
          "const": "INCOMPLETE"
        },
        "G4": {
          "const": "NOT_AUTHORIZED"
        },
        "reference": {
          "const": "NOT_READY"
        },
        "scoring": {
          "const": "NOT_EXECUTED"
        }
      }
    }
  }
}
