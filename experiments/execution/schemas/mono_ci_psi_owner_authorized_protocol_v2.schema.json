{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_owner_authorized_protocol_v2.schema.json",
  "title": "Owner-authorized exploratory ΔA5 protocol V2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_id", "classification", "authorization", "transition", "baseline", "negative_probe", "calibration", "transition_runs", "gates"],
  "properties": {
    "schema_version": {"const": "MONO_CI_PSI_OWNER_AUTHORIZED_PROTOCOL_V2"},
    "study_id": {"const": "MONO_CI_B0_PSI_DELTA_A5_OWNER_AUTHORIZED_DEV_V2"},
    "classification": {"const": "RESEARCH_OWNER_AUTHORIZED_EXPLORATORY_DEVELOPMENT"},
    "authorization": {"type": "object", "required": ["provenance", "identity_independently_verified", "explicit_exclusions"], "properties": {"provenance": {"const": "DIRECT_USER_CONVERSATION_INSTRUCTION"}, "identity_independently_verified": {"const": false}, "explicit_exclusions": {"type": "array", "contains": {"const": "G1_completion"}, "minItems": 5}}},
    "transition": {"type": "object", "required": ["before_state", "before_commit_sha", "before_repository_tree_sha", "before_application_tree_sha", "after_state", "after_commit_sha", "after_repository_tree_sha", "after_application_tree_sha"], "properties": {"before_state": {"const": "A0_4_REPORT_QUERY_PORT"}, "after_state": {"const": "A0_5_MODULE_DATA_OWNERSHIP"}, "before_commit_sha": {"const": "d3101c0d3aa9b7b709253b6ec7518416f05f65b9"}, "after_commit_sha": {"const": "a349d19fb89b577e6799e9736ed4ce0acc572166"}}},
    "baseline": {"type": "object", "properties": {"identity": {"const": "PROSPECTIVE_RECONSTRUCTED_NOT_HISTORICAL"}, "approval": {"const": "NOT_APPROVED"}}},
    "negative_probe": {"type": "object", "properties": {"passed_to_psi": {"const": false}, "new_holdout": {"const": false}}},
    "calibration": {"type": "object", "required": ["evaluators", "warmups_per_cell", "measured_repetitions_per_cell", "negative_probe_planned_total_calls", "clean_source_control_rule", "random_seed"], "properties": {"evaluators": {"const": ["AC_PUBLIC_API", "AC_MODULE_GRAPH", "AC_DATA_OWNERSHIP"]}, "warmups_per_cell": {"const": 1}, "measured_repetitions_per_cell": {"const": 10}, "negative_probe_planned_total_calls": {"const": 33}, "random_seed": {"const": 20261027}}},
    "transition_runs": {"type": "object", "required": ["warmup_runs", "measured_runs", "b0_controls", "scoring", "coverage"], "properties": {"warmup_runs": {"const": 1}, "measured_runs": {"const": 3}, "b0_controls": {"const": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"]}, "scoring": {"const": "NOT_EXECUTED"}, "coverage": {"const": "UNKNOWN"}}},
    "gates": {"type": "object", "required": ["P_ALGORITHM_STATUS", "G1", "G4", "official_delta_a5_protocol"], "properties": {"P_ALGORITHM_STATUS": {"const": "NOT_READY"}, "G1": {"const": "INCOMPLETE"}, "G4": {"const": "NOT_AUTHORIZED"}}}
  }
}
