{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_owner_authorized_pre_run_freeze_v1.schema.json",
  "title": "Pre-run source and protocol freeze for exploratory ΔA5",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_id", "classification", "implementation_commit", "source_identities", "baseline", "historical_probe", "protocol_and_execution_inputs_sha256", "measurement_plan"],
  "properties": {
    "schema_version": {"const": "MONO_CI_PSI_OWNER_AUTHORIZED_PRE_RUN_FREEZE_V1"},
    "study_id": {"const": "MONO_CI_B0_PSI_DELTA_A5_OWNER_AUTHORIZED_DEV_V1"},
    "classification": {"const": "PRE_REGISTERED_EXPLORATORY_DEVELOPMENT"},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_identities": {"type": "object", "required": ["a04_commit", "a04_repository_tree", "a04_application_tree", "a05_commit", "a05_repository_tree", "a05_application_tree"], "properties": {"a04_commit": {"const": "d3101c0d3aa9b7b709253b6ec7518416f05f65b9"}, "a04_repository_tree": {"const": "2b436e0aaf09403ea516d73d20a466a122f86592"}, "a04_application_tree": {"const": "007196f68652bc13f6798805793ffdfae96f95f7"}, "a05_commit": {"const": "a349d19fb89b577e6799e9736ed4ce0acc572166"}, "a05_repository_tree": {"const": "97c060cc26313a879f0940a178d42e422cc4d188"}, "a05_application_tree": {"const": "007196f68652bc13f6798805793ffdfae96f95f7"}}},
    "baseline": {"type": "object", "required": ["path", "sha256", "identity", "approval"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "identity": {"const": "PROSPECTIVE_RECONSTRUCTION_NOT_HISTORICAL"}, "approval": {"const": "NOT_APPROVED"}}},
    "historical_probe": {"type": "object", "required": ["manifest_sha256", "patch_sha256", "modified_source_sha256", "historical_inner_archive_sha256"], "properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}, "patch_sha256": {"$ref": "#/$defs/sha256"}, "modified_source_sha256": {"$ref": "#/$defs/sha256"}, "historical_inner_archive_sha256": {"$ref": "#/$defs/sha256"}}},
    "protocol_and_execution_inputs_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "measurement_plan": {"type": "object", "required": ["calibration_warmups_per_cell", "calibration_measured_repetitions_per_cell", "transition_warmups", "transition_measured_repetitions", "random_seed", "calibration_budget_seconds", "transition_budget_seconds", "total_execution_budget_seconds", "scoring", "coverage", "official_g1", "official_g4"], "properties": {"calibration_measured_repetitions_per_cell": {"const": 10}, "transition_measured_repetitions": {"const": 3}, "total_execution_budget_seconds": {"const": 2700}, "scoring": {"const": "NOT_EXECUTED"}, "coverage": {"const": "UNKNOWN"}, "official_g1": {"const": "INCOMPLETE"}, "official_g4": {"const": "NOT_AUTHORIZED"}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
