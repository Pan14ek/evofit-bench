{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evofitbench:pilot02-inherited-evaluator-inventory:v1",
  "title": "PILOT-02 inherited evaluator source inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "architecture_source_sha",
    "application_tree_sha",
    "profile_id",
    "profile_sha256",
    "representations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^pilot02-inherited-[A-Za-z0-9][A-Za-z0-9._-]{0,48}$"},
    "source_revision": {"$ref": "#/$defs/sha1"},
    "architecture_source_sha": {"$ref": "#/$defs/sha1"},
    "application_tree_sha": {"$ref": "#/$defs/sha1"},
    "profile_id": {"const": "PILOT_02_A0_1_ARCHITECTURE_COMPLIANCE_V2"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "representations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/evaluator"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_id",
        "evaluator_id",
        "lifecycle_stage",
        "metric_names",
        "metric_unit",
        "evaluator_version",
        "source_artifact_path",
        "source_artifact_sha256",
        "supporting_source_artifacts",
        "configuration_artifact_path",
        "configuration_artifact_sha256",
        "execution_command",
        "binding_status"
      ],
      "properties": {
        "representation_id": {"enum": ["REP_A0_PERF_TEST_HTTP_P95", "REP_A0_PERF_RUNTIME_HTTP_DURATION", "REP_A0_REL_TEST_INTEGRATION", "REP_A0_REL_RUNTIME_FAILURES"]},
        "evaluator_id": {"type": "string", "minLength": 1},
        "lifecycle_stage": {"enum": ["test", "runtime"]},
        "metric_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "metric_unit": {"type": "string", "minLength": 1},
        "evaluator_version": {"type": "string", "minLength": 1},
        "source_artifact_path": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "supporting_source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "configuration_artifact_path": {"type": "string", "minLength": 1},
        "configuration_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "execution_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "binding_status": {"const": "A0_1_DEVELOPMENT_ADAPTER"}
      }
    }
  }
}
