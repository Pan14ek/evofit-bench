{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_positive_add_study_archive_v1.schema.json",
  "title": "Positive ADD study outer evidence archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "members"],
  "properties": {
    "schema_version": {"const": "MONO_CI_A05_POSITIVE_ADD_STUDY_ARCHIVE_V1"},
    "study_id": {"const": "MONO_CI_A05_POSITIVE_ADD_TEST_ONLY_V1"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*(?:scorer|scoring|oracle|reference|ground_truth|groundtruth)(?:/|$)).+$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
