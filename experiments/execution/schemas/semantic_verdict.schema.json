{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.local/execution/semantic_verdict.schema.json",
  "title": "Independent semantic validity verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "representation_id", "architecture_source_sha", "status", "reason_codes",
    "active", "mapping_resolved", "stage_applicable", "semantic_compatible",
    "executable_nonvacuous", "evidence_contract_satisfied", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "representation_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "architecture_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "status": {
      "enum": [
        "VALID_APPLICABLE", "SEMANTIC_MISMATCH", "STALE_ARCHITECTURE_SCOPE",
        "MISSING_ARCHITECTURE_TARGET", "VACUOUS_SUCCESS", "MISSING_EVIDENCE",
        "EXECUTION_FAILURE", "INFRASTRUCTURE_FAILURE", "STAGE_OR_CONTEXT_MISMATCH",
        "OBLIGATION_MAPPING_MISMATCH", "INACTIVE", "REFERENCE_CHECKER_ERROR",
        "PROTOCOL_VIOLATION"
      ]
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active": {"type": "boolean"},
    "mapping_resolved": {"type": "boolean"},
    "stage_applicable": {"type": "boolean"},
    "semantic_compatible": {"type": ["boolean", "null"]},
    "executable_nonvacuous": {"type": "boolean"},
    "evidence_contract_satisfied": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
