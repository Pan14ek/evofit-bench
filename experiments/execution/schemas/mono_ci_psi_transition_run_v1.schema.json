{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_transition_run_v1.schema.json",
  "title": "Single-transition Method P DEVELOPMENT run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "source_revision_sha", "study_id", "mode", "unit_of_analysis", "study_readiness", "measurement_status", "p_algorithm_status", "g1", "g4", "reference_gate", "method_implementation", "baseline", "transition", "policy_source", "method_input", "runtime", "execution_engine", "psi", "other_arms_or_case_outputs_used", "metrics", "output_checksums"],
  "properties": {
    "schema_version": {"const": "MONO_CI_PSI_TRANSITION_RUN_V1"},
    "execution_id": {"type": "string", "pattern": "^DEV_PSI_TRANSITION_[A-Za-z0-9_-]{1,48}$"},
    "source_revision_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "study_id": {"const": "MONO_CI_B0_PSI_DEVELOPMENT_TECHNICAL_VALIDATION"},
    "mode": {"const": "DEVELOPMENT_METHOD_EXECUTION_ONLY"},
    "unit_of_analysis": {"const": "ONE_A0_3_TO_A0_4_ARCHITECTURE_TRANSITION"},
    "study_readiness": {"const": "NO_GO"},
    "measurement_status": {"const": "NOT_EXECUTED"},
    "p_algorithm_status": {"const": "NOT_READY"},
    "g1": {"const": "INCOMPLETE"},
    "g4": {"const": "NOT_AUTHORIZED"},
    "reference_gate": {"const": "NOT_READY"},
    "method_implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "source_path", "sha256"],
      "properties": {"identity": {"const": "P_GOVERNED_ADAPTATION_DEVELOPMENT_V1"}, "source_path": {"const": "experiments/execution/tooling/p_adaptation.py"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration_id", "configuration_sha256", "identity_status", "approval_status", "method_input_authorized"],
      "properties": {
        "configuration_id": {"const": "MONO_CI_RECONSTRUCTED_B0_A03_V1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "identity_status": {"const": "PROSPECTIVE_RECONSTRUCTION_NOT_HISTORICAL"},
        "approval_status": {"const": "NOT_APPROVED"},
        "method_input_authorized": {"const": false}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["before_state", "after_state", "before_commit_sha", "after_commit_sha", "before_repository_tree_sha", "after_repository_tree_sha", "before_application_tree_sha", "after_application_tree_sha", "before_state_manifest_sha256", "after_state_manifest_sha256", "state_manifest_path"],
      "properties": {
        "before_state": {"const": "A0_3_GOVERNED_MODULE_GRAPH"},
        "after_state": {"const": "A0_4_REPORT_QUERY_PORT"},
        "before_commit_sha": {"const": "26a9bb667da7d0938e38aca15d2bf29fd1de4829"},
        "after_commit_sha": {"const": "d3101c0d3aa9b7b709253b6ec7518416f05f65b9"},
        "before_repository_tree_sha": {"const": "7b951421395f532ca403dab09d76902ff08a807d"},
        "after_repository_tree_sha": {"const": "2b436e0aaf09403ea516d73d20a466a122f86592"},
        "before_application_tree_sha": {"const": "b147b8961ea9e76c966663d4832e4c303581151a"},
        "after_application_tree_sha": {"const": "007196f68652bc13f6798805793ffdfae96f95f7"},
        "before_state_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "after_state_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "state_manifest_path": {"const": "provenance/transition-state-manifests.json"}
      }
    },
    "policy_source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "bundle_sha256", "authority_status"],
      "properties": {"revision": {"type": "string", "minLength": 1}, "bundle_sha256": {"$ref": "#/$defs/sha256"}, "authority_status": {"const": "DRAFT_OPEN_UNAPPROVED"}}
    },
    "method_input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bundle_sha256", "common_snapshot_sha256", "baseline_proposal_sha256", "structural_manifest_path"],
      "properties": {"path": {"const": "PSI/method-input"}, "bundle_sha256": {"$ref": "#/$defs/sha256"}, "common_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "baseline_proposal_sha256": {"$ref": "#/$defs/sha256"}, "structural_manifest_path": {"const": "architecture/states/A0_4_REPORT_QUERY_PORT.yaml"}}
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "inventory_sha256", "isolation"],
      "properties": {"path": {"const": "PSI/method-runtime"}, "inventory_sha256": {"$ref": "#/$defs/sha256"}, "isolation": {"const": "PYTHON_ISOLATED_MODE; NO_NETWORK; SOURCE_REPOSITORIES_DENIED"}}
    },
    "execution_engine": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "provenance/transition-runner.py"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "psi": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "decision", "raw_result_path", "raw_result_sha256", "operation_emitted", "governance_decision_emitted", "prediction_emitted", "scoring", "execution_duration_ms"],
      "properties": {
        "status": {"const": "DEVELOPMENT_METHOD_EXECUTED"},
        "decision": {"enum": ["HOLD", "REJECT"]},
        "raw_result_path": {"const": "PSI/raw/method-result.json"},
        "raw_result_sha256": {"$ref": "#/$defs/sha256"},
        "operation_emitted": {"const": true},
        "governance_decision_emitted": {"const": true},
        "prediction_emitted": {"const": false},
        "scoring": {"const": "NOT_EXECUTED"},
        "execution_duration_ms": {"type": "number", "minimum": 0}
      }
    },
    "other_arms_or_case_outputs_used": {"const": false},
    "metrics": {"const": "NOT_MEASURED"},
    "output_checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
