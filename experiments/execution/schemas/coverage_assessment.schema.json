{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.local/execution/coverage_assessment.schema.json",
  "title": "Version 2 obligation-level coverage and pair-evidence assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "architecture_source_sha", "required_obligations", "denominator",
    "covered_count", "coverage", "covered_obligations", "uncovered_obligations",
    "stale_representations", "invalid_representations", "violation_counts", "violation_denominator",
    "pair_assessments", "valid_cover_pairs"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "architecture_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "required_obligations": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "denominator": {"type": "integer", "minimum": 1},
    "covered_count": {"type": "integer", "minimum": 0},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "covered_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncovered_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stale_representations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invalid_representations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "violation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "violation_denominator": {"type": "integer", "minimum": 0},
    "violation_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "pair_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation_id", "obligation_id", "architecture_source_sha", "status", "reason_codes", "evidence_refs"],
        "properties": {
          "representation_id": {"type": "string"},
          "obligation_id": {"type": "string"},
          "architecture_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "status": {
            "enum": [
              "VALID_APPLICABLE", "SEMANTIC_MISMATCH", "STALE_ARCHITECTURE_SCOPE",
              "MISSING_ARCHITECTURE_TARGET", "VACUOUS_SUCCESS", "MISSING_EVIDENCE",
              "EXECUTION_FAILURE", "INFRASTRUCTURE_FAILURE", "STAGE_OR_CONTEXT_MISMATCH",
              "OBLIGATION_MAPPING_MISMATCH", "INACTIVE", "REFERENCE_CHECKER_ERROR", "PROTOCOL_VIOLATION"
            ]
          },
          "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "valid_cover_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation_id", "obligation_id", "architecture_source_sha", "evidence_refs"],
        "properties": {
          "representation_id": {"type": "string"},
          "obligation_id": {"type": "string"},
          "architecture_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        }
      }
    }
  }
}
