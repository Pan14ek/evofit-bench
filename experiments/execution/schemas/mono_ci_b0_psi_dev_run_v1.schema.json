{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_b0_psi_dev_run_v1.schema.json",
  "title": "MONO CI B0/Ψ development technical validation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "study_id", "parent_study_id", "mode", "study_readiness", "measurement_status", "baseline", "common_input_parity", "arms", "metrics", "scoring", "output_checksums"],
  "properties": {
    "schema_version": {"const": "MONO_CI_B0_PSI_DEV_RUN_V1"},
    "execution_id": {"type": "string", "pattern": "^DEV_MONO_CI_[A-Za-z0-9_-]{1,48}$"},
    "study_id": {"const": "MONO_CI_B0_PSI_DEVELOPMENT_TECHNICAL_VALIDATION"},
    "parent_study_id": {"const": "MONO_CI_B0_PSI_COMPARISON_V1"},
    "mode": {"const": "DEVELOPMENT_TECHNICAL_VALIDATION_ONLY"},
    "study_readiness": {"const": "NO_GO"},
    "measurement_status": {"const": "NOT_EXECUTED"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["configuration_id", "configuration_sha256", "identity_status", "approval_status"], "properties": {"configuration_id": {"const": "MONO_CI_RECONSTRUCTED_B0_A03_V1"}, "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "identity_status": {"const": "PROSPECTIVE_RECONSTRUCTION_NOT_HISTORICAL"}, "approval_status": {"const": "NOT_APPROVED"}}},
    "common_input_parity": {"type": "object", "additionalProperties": false, "required": ["status", "case_count", "common_input_ids"], "properties": {"status": {"const": "PASS_DEVELOPMENT_COMMON_INPUTS_ONLY"}, "case_count": {"const": 4}, "common_input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "arms": {"type": "object", "additionalProperties": false, "required": ["B0", "PSI"], "properties": {"B0": {"type": "object", "additionalProperties": false, "required": ["status", "case_results", "adaptation_operation", "governance_decision", "technical_duration_boundary"], "properties": {"status": {"const": "DEVELOPMENT_EVALUATOR_PROBE_ONLY"}, "case_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/caseResult"}}, "adaptation_operation": {"type": "null"}, "governance_decision": {"type": "null"}, "technical_duration_boundary": {"const": "CASE_START_THROUGH_RAW_EVALUATOR_OUTPUT_CHECKSUM_SEAL"}}}, "PSI": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "prediction_emitted", "operation_emitted", "governance_decision_emitted"], "properties": {"status": {"const": "BLOCKED_NOT_EXECUTED"}, "reason": {"const": "P_ALGORITHM_STATUS_NOT_READY"}, "prediction_emitted": {"const": false}, "operation_emitted": {"const": false}, "governance_decision_emitted": {"const": false}}}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["operation_selection_correctness", "governance_decision_correctness", "current_configuration_verified_coverage", "controlled_violation_detection", "stale_or_semantically_invalid_representations", "assessed_candidate_coverage", "actual_post_adaptation_coverage", "end_to_end_case_execution_duration"], "properties": {"operation_selection_correctness": {"const": {"B0": "N/A", "PSI": "NOT_EVALUABLE"}}, "governance_decision_correctness": {"const": {"B0": "N/A", "PSI": "NOT_EVALUABLE"}}, "current_configuration_verified_coverage": {"const": {"B0": "NOT_EVALUABLE", "PSI": "NOT_EVALUABLE"}}, "controlled_violation_detection": {"const": {"B0": "NOT_MEASURED", "PSI": "NOT_MEASURED"}}, "stale_or_semantically_invalid_representations": {"const": {"B0": "NOT_EVALUABLE", "PSI": "NOT_EVALUABLE"}}, "assessed_candidate_coverage": {"const": {"B0": "N/A", "PSI": "NOT_MEASURED"}}, "actual_post_adaptation_coverage": {"const": {"B0": "N/A", "PSI": "NOT_MEASURED"}}, "end_to_end_case_execution_duration": {"const": {"B0": "NOT_MEASURED", "PSI": "NOT_MEASURED"}}}},
    "scoring": {"const": "NOT_EXECUTED_NO_SCORER_REFERENCE"},
    "output_checksums": {"type": "object", "minProperties": 1, "patternProperties": {"^(?!.*(?:scorer|oracle|expected|reference|\\.git)).+$": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  },
  "$defs": {
    "caseResult": {"type": "object", "additionalProperties": false, "required": ["case_id", "source_commit_sha", "repository_tree_sha", "application_tree_sha", "status", "scientific_applicability", "fitness_validity", "input_bundle_sha256", "execution_binding", "evaluators", "technical_duration_ns", "result_paths"], "properties": {"case_id": {"type": "string", "pattern": "^CASE_0[1-4]$"}, "source_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "repository_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "application_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "status": {"const": "DEVELOPMENT_ONLY_EXECUTED"}, "scientific_applicability": {"const": "UNKNOWN"}, "fitness_validity": {"const": "UNKNOWN"}, "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "execution_binding": {"type": "object", "additionalProperties": false, "required": ["workspace_kind", "checkout_commit_sha", "repository_tree_sha", "application_tree_sha", "source_file_count", "source_file_map_sha256", "input_bundle_sha256", "target_state_manifest_path", "target_state_manifest_sha256", "evaluator_configurations"], "properties": {"workspace_kind": {"const": "GIT_CHECKOUT_BYTE_EQUIVALENT_TO_VERIFIED_BUNDLE"}, "checkout_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "repository_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "application_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "source_file_count": {"type": "integer", "minimum": 1}, "source_file_map_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "target_state_manifest_path": {"const": "architecture/state-target.yaml"}, "target_state_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evaluator_configurations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["evaluator_id", "bundle_path", "configuration_sha256"], "properties": {"evaluator_id": {"enum": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"]}, "bundle_path": {"type": "string", "pattern": "^evaluators/AC_(PUBLIC_API|MODULE_GRAPH)\\.yaml$"}, "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}}}, "evaluators": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["evaluator_id", "version", "source_sha256", "configuration_sha256", "exit_code", "compliance", "raw_output_path", "raw_output_sha256"], "properties": {"evaluator_id": {"enum": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"]}, "version": {"const": "1.0.0"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "exit_code": {"type": "integer"}, "compliance": {"enum": ["COMPLIANT", "NON_COMPLIANT", "NOT_EVALUABLE", "UNKNOWN", "NOT_APPLICABLE"]}, "raw_output_path": {"type": "string", "pattern": "^B0/raw/CASE_0[1-4]/AC_(PUBLIC_API|MODULE_GRAPH)\\.json$"}, "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}, "technical_duration_ns": {"type": "integer", "minimum": 0}, "result_paths": {"type": "array", "minItems": 2, "items": {"type": "string"}}}}
  }
}
