{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.example/schemas/b0p_development_study_v1.schema.json",
  "title": "B0/P DEVELOPMENT preparation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "run_id",
    "execution_status",
    "exposure_class",
    "source_revisions",
    "b0",
    "method_p",
    "architecture_facts",
    "instrumentation",
    "reference",
    "research_gates",
    "blockers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "study_id": { "const": "DEV-B0P-V1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "execution_status": { "const": "PREPARED_NOT_EXECUTED" },
    "exposure_class": { "const": "CALIBRATION_EXPOSED" },
    "source_revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_base_sha",
        "architecture_before_sha",
        "architecture_after_sha",
        "b0_source_sha",
        "p_source_sha",
        "policy_source_sha"
      ],
      "properties": {
        "study_base_sha": { "$ref": "#/$defs/gitSha" },
        "architecture_before_sha": { "$ref": "#/$defs/gitSha" },
        "architecture_after_sha": { "$ref": "#/$defs/gitSha" },
        "b0_source_sha": { "$ref": "#/$defs/gitSha" },
        "p_source_sha": { "$ref": "#/$defs/gitSha" },
        "policy_source_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "b0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_version",
        "source_inventory",
        "source_sha256",
        "configuration_path",
        "configuration_sha256",
        "evaluator_configuration_path",
        "evaluator_configuration_sha256",
        "input_bundle_path",
        "input_bundle_sha256"
      ],
      "properties": {
        "method_version": { "const": "B0_UNCHANGED_V1" },
        "source_inventory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRecord" } },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_path": { "type": "string", "minLength": 1 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "evaluator_configuration_path": { "type": "string", "minLength": 1 },
        "evaluator_configuration_sha256": { "$ref": "#/$defs/sha256" },
        "input_bundle_path": { "type": "string", "minLength": 1 },
        "input_bundle_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "method_p": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_version",
        "source_inventory",
        "algorithm_sha256",
        "input_bundle_path",
        "input_bundle_sha256",
        "policy_source_revision",
        "policy_bundle_sha256",
        "governance_status",
        "algorithm_status"
      ],
      "properties": {
        "method_version": { "const": "P_GOVERNED_ADAPTATION_DEVELOPMENT_V1" },
        "source_inventory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRecord" } },
        "algorithm_sha256": { "$ref": "#/$defs/sha256" },
        "input_bundle_path": { "type": "string", "minLength": 1 },
        "input_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "policy_source_revision": { "type": "string", "minLength": 1 },
        "policy_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "governance_status": { "const": "NOT_RUN" },
        "algorithm_status": { "const": "NOT_READY" }
      }
    },
    "architecture_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "assessment", "verification_path", "verification_sha256"],
      "properties": {
        "path": { "const": "architecture_facts.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "assessment": { "const": "VERIFIED_GIT_INVENTORY" },
        "verification_path": { "const": "git_inventory_verification.json" },
        "verification_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_revision",
        "runner_source_state",
        "study_base_sha",
        "method_input_exporter_v1_sha256",
        "method_input_exporter_v3_sha256",
        "prediction_sealer_sha256",
        "scorer_sha256",
        "semantic_validity_sha256",
        "b0_builder_sha256",
        "development_protocol_sha256",
        "runner_sha256",
        "independent_inventory_verifier_sha256",
        "preparation_cli_sha256",
        "readback_cli_sha256",
        "study_manifest_schema_sha256",
        "p_runtime_image_digest",
        "evaluator_runtime_pins_status"
      ],
      "properties": {
        "runner_revision": { "$ref": "#/$defs/gitSha" },
        "runner_source_state": { "enum": ["COMMITTED", "UNCOMMITTED_WORKTREE"] },
        "study_base_sha": { "$ref": "#/$defs/gitSha" },
        "method_input_exporter_v1_sha256": { "$ref": "#/$defs/sha256" },
        "method_input_exporter_v3_sha256": { "$ref": "#/$defs/sha256" },
        "prediction_sealer_sha256": { "$ref": "#/$defs/sha256" },
        "scorer_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_validity_sha256": { "$ref": "#/$defs/sha256" },
        "b0_builder_sha256": { "$ref": "#/$defs/sha256" },
        "development_protocol_sha256": { "$ref": "#/$defs/sha256" },
        "runner_sha256": { "$ref": "#/$defs/sha256" },
        "independent_inventory_verifier_sha256": { "$ref": "#/$defs/sha256" },
        "preparation_cli_sha256": { "$ref": "#/$defs/sha256" },
        "readback_cli_sha256": { "$ref": "#/$defs/sha256" },
        "study_manifest_schema_sha256": { "$ref": "#/$defs/sha256" },
        "p_runtime_image_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "evaluator_runtime_pins_status": { "const": "NOT_PINNED" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody",
        "read_during_preparation",
        "required_obligation_count",
        "denominator_source_path",
        "denominator_source_sha256",
        "oracle_identifiers_read_during_preparation"
      ],
      "properties": {
        "custody": { "const": "SCORER_ONLY_NOT_OPENED_DURING_PREPARATION" },
        "read_during_preparation": { "const": false },
        "required_obligation_count": { "const": 6 },
        "denominator_source_path": { "const": "docs/g1/B0P_DEVELOPMENT_PROTOCOL_V1.md" },
        "denominator_source_sha256": { "$ref": "#/$defs/sha256" },
        "oracle_identifiers_read_during_preparation": { "const": false }
      }
    },
    "research_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G1", "G4"],
      "properties": {
        "G1": { "const": "INCOMPLETE" },
        "G4": { "const": "NOT AUTHORIZED" }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
