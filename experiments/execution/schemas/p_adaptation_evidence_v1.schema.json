{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.dev/schemas/p_adaptation_evidence_v1.schema.json",
  "title": "SPEC 03 Verified Adaptation Evidence Sidecar V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "input_bundle_sha256",
    "architecture_before_sha",
    "architecture_after_sha",
    "policy_source_revision",
    "policy_bundle_sha256",
    "evaluation_as_of",
    "scope",
    "source_bindings",
    "verifier_id",
    "payload",
    "sidecar_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "const": "P_ADAPTATION_EVIDENCE_V1" },
    "input_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "architecture_before_sha": { "$ref": "#/$defs/sha1" },
    "architecture_after_sha": { "$ref": "#/$defs/sha1" },
    "policy_source_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "evaluation_as_of": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceBinding" }
    },
    "verifier_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" },
    "payload": { "$ref": "#/$defs/payload" },
    "sidecar_sha256": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "subject_sha256", "scope", "architecture_source_shas", "verifier_id", "source_bindings", "evidence_refs"],
      "properties": {
        "status": { "enum": ["VALID", "INVALID", "UNDETERMINED"] },
        "subject_sha256": { "$ref": "#/$defs/sha256" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "architecture_source_shas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha1" }
        },
        "verifier_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" },
        "source_bindings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourceBinding" } },
        "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" } }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_evidence",
        "pair_proofs",
        "artifact_bytes",
        "fact_absence_proofs",
        "policy_inventories",
        "trace_inventory_proof",
        "change_inventory_proof",
        "required_stages",
        "stage_contract_proof",
        "adjustment_rules",
        "authorized_template_artifact_sha256",
        "cost_model_proof"
      ],
      "properties": {
        "evaluator_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representation_id", "obligation_id", "evidence"],
            "properties": {
              "representation_id": { "type": "string", "minLength": 1 },
              "obligation_id": { "type": "string", "minLength": 1 },
              "evidence": { "type": "object" }
            }
          }
        },
        "pair_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representation_id", "obligation_id", "status", "subject_sha256", "verifier_id", "source_bindings", "evidence_refs", "reason_codes"],
            "properties": {
              "representation_id": { "type": "string", "minLength": 1 },
              "obligation_id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["VALID", "INVALID", "UNDETERMINED"] },
              "subject_sha256": { "$ref": "#/$defs/sha256" },
              "verifier_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" },
              "source_bindings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourceBinding" } },
              "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" } },
              "reason_codes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$" } }
            }
          }
        },
        "artifact_bytes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "content_base64"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "content_base64": { "type": "string" }
            }
          }
        },
        "fact_absence_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "predicate", "scope", "architecture_source_sha", "proof"],
            "properties": {
              "state": { "enum": ["before", "after"] },
              "predicate": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "architecture_source_sha": { "$ref": "#/$defs/sha1" },
              "proof": { "$ref": "#/$defs/evidenceProof" }
            }
          }
        },
        "policy_inventories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "scope", "architecture_source_sha", "rows", "proof"],
            "properties": {
              "state": { "enum": ["before", "after"] },
              "scope": { "type": "string", "minLength": 1 },
              "architecture_source_sha": { "$ref": "#/$defs/sha1" },
              "rows": { "type": "array", "items": { "type": "object" } },
              "proof": { "$ref": "#/$defs/evidenceProof" }
            }
          }
        },
        "trace_inventory_proof": { "$ref": "#/$defs/evidenceProof" },
        "change_inventory_proof": { "$ref": "#/$defs/evidenceProof" },
        "required_stages": {
          "type": "object",
          "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "stage_contract_proof": { "$ref": "#/$defs/evidenceProof" },
        "adjustment_rules": { "type": "array", "items": { "type": "object" } },
        "authorized_template_artifact_sha256": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "cost_model_proof": { "$ref": "#/$defs/evidenceProof" }
      }
    }
  }
}
