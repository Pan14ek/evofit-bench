{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evofitbench:pilot02-inherited-evaluator-results:v1",
  "title": "PILOT-02 inherited evaluator DEVELOPMENT results v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "architecture_state",
    "compose_project",
    "comparison_role",
    "representations",
    "profile_sha256",
    "evaluator_inventory_sha256",
    "comparison_interpretation",
    "exp01",
    "exp01_command",
    "integration_command",
    "method_p",
    "method_p_command",
    "setup_commands",
    "cleanup_command",
    "limitations",
    "execution_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^pilot02-inherited-[A-Za-z0-9][A-Za-z0-9._-]{0,48}$"},
    "source_revision": {"$ref": "#/$defs/sha1"},
    "architecture_state": {"const": "A0_1_CAPABILITY_MODULES"},
    "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "comparison_role": {"type": "string", "minLength": 1},
    "representations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/representation"}
    },
    "comparison_interpretation": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "exp01": {"type": "object"},
    "exp01_command": {"type": "object"},
    "integration_command": {"type": "object"},
    "method_p": {"type": "object"},
    "method_p_command": {"type": ["object", "null"]},
    "setup_commands": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "cleanup_command": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution_status": {"enum": ["completed_development_evidence", "partial"]}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "required": [
        "run_id", "representation_id", "evaluator_id", "evaluator", "status",
        "architecture_source_sha", "application_tree_sha", "source_revision",
        "lifecycle_stage", "metric_name", "metric_names", "metric_unit", "metric_value",
        "metric_status", "evaluation_status", "execution_status", "execution_command",
        "evaluator_version", "started_at_utc", "ended_at_utc", "duration_ns", "exit_code",
        "source_artifact_path", "source_artifact_sha256", "supporting_source_artifacts",
        "configuration_artifact_path", "configuration_artifact_sha256", "raw_stdout_path",
        "raw_stdout_sha256", "raw_stderr_path", "raw_stderr_sha256", "raw_output_artifacts",
        "source_provenance_status", "binding_status", "metrics"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "representation_id": {"enum": ["REP_A0_PERF_TEST_HTTP_P95", "REP_A0_PERF_RUNTIME_HTTP_DURATION", "REP_A0_REL_TEST_INTEGRATION", "REP_A0_REL_RUNTIME_FAILURES"]},
        "evaluator_id": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "status": {"enum": ["measured", "partial"]},
        "architecture_source_sha": {"$ref": "#/$defs/sha1"},
        "application_tree_sha": {"$ref": "#/$defs/sha1"},
        "source_revision": {"$ref": "#/$defs/sha1"},
        "lifecycle_stage": {"enum": ["test", "runtime"]},
        "metric_name": {"type": "string", "minLength": 1},
        "metric_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "metric_unit": {"type": "string", "minLength": 1},
        "metric_value": {},
        "metric_status": {"enum": ["available", "unavailable"]},
        "evaluation_status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_EVALUATED"]},
        "execution_status": {"enum": ["measured", "partial"]},
        "execution_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evaluator_version": {"type": "string", "minLength": 1},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "ended_at_utc": {"type": "string", "format": "date-time"},
        "duration_ns": {"type": "integer", "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "source_artifact_path": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "supporting_source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "configuration_artifact_path": {"type": "string", "minLength": 1},
        "configuration_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "raw_stdout_path": {"type": "string", "minLength": 1},
        "raw_stdout_sha256": {"$ref": "#/$defs/sha256"},
        "raw_stderr_path": {"type": "string", "minLength": 1},
        "raw_stderr_sha256": {"$ref": "#/$defs/sha256"},
        "raw_output_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "source_provenance_status": {"type": "string", "minLength": 1},
        "binding_status": {"const": "A0_1_DEVELOPMENT_ADAPTER"},
        "metrics": {"type": "object"}
      }
    }
  }
}
