{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_b0_psi_inputs_v1.schema.json",
  "title": "MONO CI B0 vs governed adaptation Ψ input inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "input_manifest_status", "measurement_status", "case_manifest_path", "case_manifest_sha256", "common_input_ids_plan", "shared_policy_context", "source_artifacts", "case_sources", "arms", "reference_separation"],
  "properties": {
    "schema_version": {"const": "MONO_CI_B0_PSI_INPUTS_V1"},
    "study_id": {"const": "MONO_CI_B0_PSI_COMPARISON_V1"},
    "input_manifest_status": {"const": "PLAN_ONLY_BUNDLES_NOT_CREATED"},
    "measurement_status": {"const": "NOT_EXECUTED"},
    "case_manifest_path": {"type": "string"}, "case_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "common_input_ids_plan": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "shared_policy_context": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "registry_status", "applicability", "method_input_eligible"],
      "properties": {"status": {"const": "NO_APPROVED_POLICY_AVAILABLE"}, "registry_status": {"const": "DRAFT_OPEN"}, "applicability": {"const": "UNKNOWN"}, "method_input_eligible": {"const": false}}
    },
    "source_artifacts": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "role", "method_input_eligible"],
        "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"type": "string"}, "method_input_eligible": {"type": "boolean"}}
      }
    },
    "case_sources": {
      "type": "array", "minItems": 4, "maxItems": 4, "items": {
        "type": "object", "additionalProperties": false, "required": ["case_id", "source_commit_sha", "repository_tree_sha", "application_tree_sha", "source_snapshot_status"],
        "properties": {"case_id": {"type": "string", "pattern": "^CASE_0[1-4]$"}, "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "repository_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "application_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_snapshot_status": {"const": "NOT_EXPORTED_TO_METHOD_BUNDLE"}}
      }
    },
    "arms": {
      "type": "object", "additionalProperties": false, "required": ["B0", "PSI"],
      "properties": {
        "B0": {"$ref": "#/$defs/b0Arm"}, "PSI": {"$ref": "#/$defs/psiArm"}
      }
    },
    "reference_separation": {
      "type": "object", "additionalProperties": false,
      "required": ["scorer_reference_id", "included_in_either_method_bundle", "expected_operations_status", "governance_labels_status"],
      "properties": {"scorer_reference_id": {"const": "MONO_CI_B0_PSI_REFERENCE_NOT_ESTABLISHED"}, "included_in_either_method_bundle": {"const": false}, "expected_operations_status": {"const": "NOT_CREATED"}, "governance_labels_status": {"const": "NOT_CREATED"}}
    }
  },
  "$defs": {
    "baseArm": {
      "type": "object", "required": ["science_name", "common_input_ids", "planned_case_ids", "bundle_status", "bundle_sha256", "allowlist_sha256"],
      "properties": {"science_name": {"type": "string"}, "common_input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "planned_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CASE_0[1-4]$"}}, "bundle_status": {"const": "NOT_CREATED"}, "bundle_sha256": {"type": "null"}, "allowlist_sha256": {"type": "null"}}
    },
    "b0Arm": {
      "allOf": [{"$ref": "#/$defs/baseArm"}], "additionalProperties": false,
      "required": ["science_name", "common_input_ids", "planned_case_ids", "baseline_configuration_status", "bundle_status", "bundle_sha256", "allowlist_sha256"],
      "properties": {"science_name": {"const": "unchanged fitness configuration"}, "common_input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "planned_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CASE_0[1-4]$"}}, "baseline_configuration_status": {"const": "NOT_IDENTIFIED"}, "bundle_status": {"const": "NOT_CREATED"}, "bundle_sha256": {"type": "null"}, "allowlist_sha256": {"type": "null"}}
    },
    "psiArm": {
      "allOf": [{"$ref": "#/$defs/baseArm"}], "additionalProperties": false,
      "required": ["science_name", "internal_implementation_id", "common_input_ids", "planned_case_ids", "algorithm_status", "traceability_status", "bundle_status", "bundle_sha256", "allowlist_sha256"],
      "properties": {"science_name": {"const": "governed adaptation method Ψ"}, "internal_implementation_id": {"const": "P"}, "common_input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "planned_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CASE_0[1-4]$"}}, "algorithm_status": {"const": "NOT_READY"}, "traceability_status": {"const": "NOT_ASSEMBLED"}, "bundle_status": {"const": "NOT_CREATED"}, "bundle_sha256": {"type": "null"}, "allowlist_sha256": {"type": "null"}}
    }
  }
}
