{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evofitbench:exp03-method-integration-v1",
  "title": "EXP-03 DEVELOPMENT EXP-02 to Method P integration manifest",
  "description": "Digest-bound observation bridge. EXP-02 observations are not semantic pair proofs, coverage claims, or measured results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "integration_status",
    "created_at_utc",
    "reproducibility",
    "exp02_input",
    "representation_mappings",
    "coverage_claims",
    "method_p",
    "blockers",
    "artifact_inventory"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "exp03_method_integration"},
    "integration_status": {
      "enum": ["completed", "completed_with_hold", "completed_with_reject", "blocked"]
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_version",
        "bridge_source_sha256",
        "schema_sha256",
        "trace_schema_sha256",
        "python_version",
        "platform",
        "invocation"
      ],
      "properties": {
        "bridge_version": {"const": "EXP03_METHOD_BRIDGE_V1"},
        "bridge_source_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "trace_schema_sha256": {"$ref": "#/$defs/sha256"},
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "invocation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exp02_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_directory",
        "run_id",
        "bundle_schema_version",
        "bundle_status",
        "bundle_reference",
        "representation_evidence_reference",
        "source_revision",
        "architecture_state",
        "fitness_configuration",
        "input_artifacts",
        "evaluator_records",
        "coverage_claims",
        "limitations"
      ],
      "properties": {
        "run_directory": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "bundle_schema_version": {"const": "1.2.0"},
        "bundle_status": {"enum": ["complete", "incomplete"]},
        "bundle_reference": {"$ref": "#/$defs/inputArtifact"},
        "representation_evidence_reference": {"$ref": "#/$defs/inputArtifact"},
        "source_revision": {"$ref": "#/$defs/sha1"},
        "architecture_state": {"const": "A0_1_CAPABILITY_MODULES"},
        "fitness_configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration_id",
            "configuration_version",
            "configuration_sha256",
            "configuration_artifact",
            "provenance_status"
          ],
          "properties": {
            "configuration_id": {"const": "A0_1_CAPABILITY_MODULES_DEVELOPMENT_REFERENCE"},
            "configuration_version": {"type": "string", "minLength": 1},
            "configuration_sha256": {"$ref": "#/$defs/sha256"},
            "configuration_artifact": {"$ref": "#/$defs/inputArtifact"},
            "provenance_status": {"const": "manual_development_reference"}
          }
        },
        "input_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/inputArtifact"}
        },
        "evaluator_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "evaluator_name",
              "lifecycle_stage",
              "status",
              "execution_verdict",
              "source_revision",
              "scope_id",
              "raw_output_artifacts"
            ],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "evaluator_name": {"type": "string", "minLength": 1},
              "lifecycle_stage": {"enum": ["ci_test", "deployment", "runtime"]},
              "status": {"enum": ["available", "missing", "invalid", "skipped", "inconclusive"]},
              "execution_verdict": {
                "enum": [
                  "passed",
                  "violations_detected",
                  "execution_failure",
                  "no_usable_evidence",
                  "not_observed",
                  "not_run",
                  "inconclusive"
                ]
              },
              "source_revision": {"$ref": "#/$defs/sha1"},
              "scope_id": {"type": "string", "minLength": 1},
              "raw_output_artifacts": {
                "type": "array",
                "items": {"$ref": "#/$defs/inputArtifact"}
              }
            }
          }
        },
        "coverage_claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Coverage_P", "Coverage_ref", "semantic_validity"],
          "properties": {
            "Coverage_P": {"const": "not_assessed"},
            "Coverage_ref": {"const": "not_established"},
            "semantic_validity": {"const": "not_independently_validated"}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "representation_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exp02_representation_id",
          "criterion_id",
          "obligation_id",
          "evaluator_id",
          "evaluator_record_id",
          "evaluator_name",
          "source_stage",
          "source_scope_id",
          "source_revision",
          "target_representation_id",
          "target_stage",
          "target_evaluator",
          "target_scope",
          "mapping_status",
          "stage_mapping_status",
          "evaluator_binding_status",
          "scope_mapping_status",
          "metric_mapping_status",
          "matching_metric_names",
          "revision_binding_status",
          "semantic_pair_proof_status",
          "coverage_claim_status",
          "evaluator_execution",
          "compliance_observation",
          "scope_binding_status",
          "metrics",
          "evidence_references",
          "limitations",
          "reason_codes"
        ],
        "properties": {
          "exp02_representation_id": {"type": "string", "pattern": "^REP_[A-Z0-9_]+$"},
          "criterion_id": {"type": "string", "minLength": 1},
          "obligation_id": {"type": "string", "minLength": 1},
          "evaluator_id": {"type": "string", "pattern": "^EV_[A-Z0-9_]+$"},
          "evaluator_record_id": {"type": "string", "minLength": 1},
          "evaluator_name": {"type": "string", "minLength": 1},
          "source_stage": {"enum": ["ci_test", "deployment", "runtime"]},
          "source_scope_id": {"type": "string", "minLength": 1},
          "source_revision": {"$ref": "#/$defs/sha1"},
          "target_representation_id": {"type": ["string", "null"]},
          "target_stage": {"type": ["string", "null"]},
          "target_evaluator": {"type": ["string", "null"]},
          "target_scope": {"type": "object"},
          "mapping_status": {"enum": ["candidate_only", "unsupported", "not_available"]},
          "stage_mapping_status": {"enum": ["translated", "unsupported", "not_available"]},
          "evaluator_binding_status": {
            "enum": ["exact", "unverified", "unrepresented", "not_available"]
          },
          "scope_mapping_status": {"enum": ["exact", "unrepresented", "mismatch", "not_available"]},
          "metric_mapping_status": {"enum": ["exact", "partial", "unmatched", "unverified"]},
          "matching_metric_names": {"type": "array", "items": {"type": "string"}},
          "revision_binding_status": {
            "enum": ["exact_after_revision", "mismatch", "unverified"]
          },
          "semantic_pair_proof_status": {"const": "not_supplied"},
          "coverage_claim_status": {"const": "not_established"},
          "evaluator_execution": {
            "type": "object",
            "required": [
              "status",
              "record_id",
              "evaluator_name",
              "execution_verdict",
              "source_revision",
              "runtime_source_binding_status"
            ],
            "properties": {
              "status": {
                "enum": ["available", "missing", "invalid", "inconclusive", "unsupported"]
              },
              "record_id": {"type": "string", "minLength": 1},
              "evaluator_name": {"type": "string", "minLength": 1},
              "execution_verdict": {
                "enum": [
                  "passed",
                  "violations_detected",
                  "execution_failure",
                  "no_usable_evidence",
                  "not_observed",
                  "not_run",
                  "inconclusive"
                ]
              },
              "source_revision": {"type": ["string", "null"]},
              "runtime_source_binding_status": {
                "enum": ["verified", "unverified", "mismatch", "not_applicable", "not_observed"]
              }
            }
          },
          "compliance_observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "basis"],
            "properties": {
              "status": {"enum": ["conforming", "nonconforming", "not_assessed", "unknown"]},
              "basis": {"type": "string", "minLength": 1}
            }
          },
          "scope_binding_status": {"enum": ["matched", "mismatch", "unknown"]},
          "metrics": {"type": "array", "items": {"type": "object"}},
          "evidence_references": {
            "type": "array",
            "items": {"$ref": "#/$defs/inputArtifact"}
          },
          "limitations": {"type": "array", "items": {"type": "string"}},
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "coverage_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Coverage_P", "Coverage_ref", "semantic_validity"],
      "properties": {
        "Coverage_P": {"const": "not_assessed"},
        "Coverage_ref": {"const": "not_established"},
        "semantic_validity": {"const": "not_independently_validated"}
      }
    },
    "method_p": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_status",
        "input_directory",
        "input_bundle_sha256",
        "input_manifest_sha256",
        "input_manifest_reference",
        "architecture_before_sha",
        "architecture_after_sha",
        "delta_a1_revision_binding",
        "trust_context_supplied",
        "adaptation_evidence_sidecar_supplied",
        "exp02_observations_used_as_semantic_pair_evidence",
        "execution_status",
        "trace_reference",
        "governance_result",
        "reason_codes",
        "prediction_v1_emitted"
      ],
      "properties": {
        "input_status": {"enum": ["not_supplied", "verified", "rejected", "incompatible"]},
        "input_directory": {"type": ["string", "null"]},
        "input_bundle_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_manifest_reference": {
          "anyOf": [{"$ref": "#/$defs/inputArtifact"}, {"type": "null"}]
        },
        "architecture_before_sha": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "architecture_after_sha": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "delta_a1_revision_binding": {"enum": ["not_assessed", "verified", "mismatch"]},
        "trust_context_supplied": {"const": false},
        "adaptation_evidence_sidecar_supplied": {"const": false},
        "exp02_observations_used_as_semantic_pair_evidence": {"const": false},
        "execution_status": {"enum": ["not_run", "completed"]},
        "trace_reference": {
          "anyOf": [{"$ref": "#/$defs/outputArtifact"}, {"type": "null"}]
        },
        "governance_result": {"enum": ["ACCEPT", "HOLD", "REJECT", "not_run"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "prediction_v1_emitted": {"type": "boolean"}
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "details"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_inventory": {
      "type": "array",
      "items": {"$ref": "#/$defs/outputArtifact"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type", "role", "source_path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "source_path": {"type": ["string", "null"]}
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}
