    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "pre_run_preflight_sha256": {"$ref": "#/$defs/sha256"},
    "expected_host_identity": {"type": "object", "required": ["host_os", "host_architecture", "runner_os", "runner_image_os", "runner_image_version", "docker_client_version", "docker_server_version", "docker_daemon_platform", "docker_kernel_version", "python_runtime_image", "python_runtime_platform"]},
    "evaluator_runtime_comparison_to_v1": {"type": "object", "required": ["fields_compared", "differences", "same_evaluator_runtime"], "properties": {"fields_compared": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "differences": {"type": "array", "items": {"type": "object", "required": ["field", "v1_value", "v2_value"], "properties": {"field": {"type": "string"}, "v1_value": {}, "v2_value": {}}, "additionalProperties": false}}, "same_evaluator_runtime": {"type": "boolean"}}, "additionalProperties": false},
    "source_identities": {"type": "object", "required": ["a04_commit", "a04_repository_tree", "a04_application_tree", "a05_commit", "a05_repository_tree", "a05_application_tree"], "properties": {"a04_commit": {"const": "d3101c0d3aa9b7b709253b6ec7518416f05f65b9"}, "a04_repository_tree": {"const": "2b436e0aaf09403ea516d73d20a466a122f86592"}, "a04_application_tree": {"const": "007196f68652bc13f6798805793ffdfae96f95f7"}, "a05_commit": {"const": "a349d19fb89b577e6799e9736ed4ce0acc572166"}, "a05_repository_tree": {"const": "97c060cc26313a879f0940a178d42e422cc4d188"}, "a05_application_tree": {"const": "007196f68652bc13f6798805793ffdfae96f95f7"}}},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "historical_probe": {"type": "object", "required": ["manifest_sha256", "patch_sha256", "modified_source_sha256", "historical_inner_archive_sha256"], "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "measurement_plan": {"type": "object", "required": ["calibration_warmups_per_cell", "calibration_measured_repetitions_per_cell", "calibration_source_conditions", "transition_warmups", "transition_measured_repetitions", "random_seed", "calibration_budget_seconds", "transition_budget_seconds", "total_execution_budget_seconds", "scoring", "coverage", "official_g1", "official_g4"], "properties": {"calibration_warmups_per_cell": {"const": 1}, "calibration_measured_repetitions_per_cell": {"const": 10}, "transition_warmups": {"const": 1}, "transition_measured_repetitions": {"const": 3}, "random_seed": {"const": 20261027}, "total_execution_budget_seconds": {"const": 2700}, "scoring": {"const": "NOT_EXECUTED"}, "coverage": {"const": "UNKNOWN"}, "official_g1": {"const": "INCOMPLETE"}, "official_g4": {"const": "NOT_AUTHORIZED"}}},
    "analysis_version": {"type": "object", "required": ["module", "sha256"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
