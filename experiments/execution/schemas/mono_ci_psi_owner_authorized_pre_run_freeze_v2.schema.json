{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/mono_ci_psi_owner_authorized_pre_run_freeze_v2.schema.json",
  "title": "Pre-run source, sandbox, and protocol freeze for exploratory ΔA5 V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "classification", "freeze_created_at_utc", "implementation_commit", "protocol_sha256", "pre_run_preflight_sha256", "expected_host_identity", "evaluator_runtime_comparison_to_v1", "source_identities", "baseline_sha256", "historical_probe", "input_sha256", "measurement_plan", "analysis_version"],
  "properties": {
    "schema_version": {"const": "MONO_CI_PSI_OWNER_AUTHORIZED_PRE_RUN_FREEZE_V2"},
    "study_id": {"const": "MONO_CI_B0_PSI_DELTA_A5_OWNER_AUTHORIZED_DEV_V2"},
    "classification": {"const": "PRE_REGISTERED_EXPLORATORY_DEVELOPMENT"},
    "freeze_created_at_utc": {"type": "string", "format": "date-time"},
