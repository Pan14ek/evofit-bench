{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evofitbench.invalid/schemas/a0-3-governed-module-graph-v1.json",
  "title": "A0.3 governed module graph state record",
  "type": "object",
  "required": [
    "schema_version",
    "architecture_state",
    "predecessor_state",
    "implementation_scope",
    "invariants",
    "allowed_dependencies",
    "temporary_exceptions",
    "governance_requirements",
    "source_provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "architecture_state": { "const": "A0_3_GOVERNED_MODULE_GRAPH" },
    "predecessor_state": { "const": "A0_2_PUBLIC_MODULE_APIS" },
    "implementation_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "object",
      "required": [
        "deployment_units",
        "application_processes",
        "database_instances",
        "database_product",
        "internal_communication",
        "message_broker",
        "rest_behavior",
        "transaction_ownership"
      ],
      "properties": {
        "deployment_units": { "const": 1 },
        "application_processes": { "const": 1 },
        "database_instances": { "const": 1 },
        "database_product": { "const": "PostgreSQL" },
        "internal_communication": { "const": "synchronous_python_calls" },
        "message_broker": { "const": "none" },
        "rest_behavior": { "const": "unchanged" },
        "transaction_ownership": { "const": "caller_managed_session" }
      },
      "additionalProperties": false
    },
    "allowed_dependencies": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "enum": ["tasks", "users", "reporting"] },
          "to": { "enum": ["users", "notifications", "audit", "tasks"] }
        },
        "additionalProperties": false
      }
    },
    "temporary_exceptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_module",
          "target_module",
          "imported_names",
          "allowed_architecture_states",
          "expires_at_state"
        ],
        "properties": {
          "id": { "const": "reporting_tasks_query_intermediate_v1" },
          "source_module": { "const": "app.modules.reporting.service" },
          "target_module": { "const": "app.modules.tasks.service" },
          "imported_names": { "const": ["task_summary"] },
          "allowed_architecture_states": {
            "const": ["A0_2_PUBLIC_MODULE_APIS", "A0_3_GOVERNED_MODULE_GRAPH"]
          },
          "expires_at_state": { "const": "A0_4_REPORT_QUERY_PORT" }
        },
        "additionalProperties": false
      }
    },
    "governance_requirements": {
      "type": "object",
      "required": ["required_evaluators", "fail_closed"],
      "properties": {
        "required_evaluators": { "const": ["AC_PUBLIC_API", "AC_MODULE_GRAPH"] },
        "fail_closed": {
          "type": "object",
          "required": [
            "incomplete_source_scope",
            "source_identity_mismatch",
            "evaluator_or_configuration_digest_mismatch",
            "unresolved_imports",
            "noncompliance"
          ],
          "properties": {
            "incomplete_source_scope": { "const": true },
            "source_identity_mismatch": { "const": true },
            "evaluator_or_configuration_digest_mismatch": { "const": true },
            "unresolved_imports": { "const": true },
            "noncompliance": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_provenance": {
      "type": "object",
      "required": ["predecessor_commit", "predecessor_tree", "evaluated_source_identity"],
      "properties": {
        "predecessor_commit": {
          "const": "b003144ae78238707af555aee68a16ffa14e800b"
        },
        "predecessor_tree": {
          "const": "894f676d82a8264878ce4fb64a6c28d98a1c5fed"
        },
        "evaluated_source_identity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
